# =============================================================================
# Terraform Variables Example
# =============================================================================
# Copy this file to staging/terraform.tfvars or production/terraform.tfvars
# and fill in your values.
#
# IMPORTANT: NEVER commit terraform.tfvars with real values!
# =============================================================================

# Azure Subscription ID (REQUIRED)
# Get with: az account show --query id -o tsv
subscription_id = "00000000-0000-0000-0000-000000000000"

# Azure AD Object ID for AKS Admin Access (REQUIRED)
# Get with: az ad signed-in-user show --query id -o tsv
# For teams: Create an Azure AD group and use the group's Object ID
aks_admin_group_id = "00000000-0000-0000-0000-000000000000"

# GitOps Repository URL (REQUIRED)
# Your mercury-gitops-v2 repository SSH URL
gitops_repo_url = "git@github.com:YOUR-USER/mercury-gitops-v2.git"

# GitOps Repository Local Path (REQUIRED for local runs)
# Only needed when running terraform locally (not in CI/CD)
# CI/CD sets this automatically via -var flag
gitops_repo_local_path = "/path/to/your/mercury-gitops-v2"

# =============================================================================
# Optional: Override defaults
# =============================================================================

# Azure Region (default: northeurope)
# location = "northeurope"

# Kubernetes Version (default: 1.32)
# kubernetes_version = "1.32"

# Environment name (auto-detected from directory, but can override)
# environment = "staging"
